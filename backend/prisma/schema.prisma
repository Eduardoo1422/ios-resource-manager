datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  mustChangePassword Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model LicenseKey {
  id         String         @id @default(uuid())
  keyString  String         @unique
  validFrom  DateTime       @default(now())
  validUntil DateTime
  maxDevices Int            @default(1)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  devices    LinkedDevice[]
}

model LinkedDevice {
  id           String     @id @default(uuid())
  licenseId    String
  license      LicenseKey @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  hardwareUuid String
  deviceName   String
  linkedAt     DateTime   @default(now())
  lastActiveAt DateTime   @updatedAt

  @@unique([licenseId, hardwareUuid])
}

model Resource {
  id               String            @id @default(uuid())
  name             String
  description      String?
  bundleId         String
  targetFilePath   String
  targetFilename   String
  status           String            @default("OFFLINE") // ONLINE, MANUTENCAO, OFFLINE
  currentVersionId String?           @unique
  currentVersion   ResourceVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         ResourceVersion[] @relation("ResourceVersions")
}

model ResourceVersion {
  id          String    @id @default(uuid())
  resourceId  String
  resource    Resource  @relation("ResourceVersions", fields: [resourceId], references: [id], onDelete: Cascade)
  version     String
  fileUrl     String
  sha256      String
  fileSize    Int       @default(0)
  createdAt   DateTime  @default(now())
  resourceCurrent Resource? @relation("CurrentVersion")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  details   String? // Mapeado para JSON no código
  createdAt DateTime @default(now())
}
